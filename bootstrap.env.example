# ==============================================================================
# Azure Infrastructure Bootstrap Configuration Template
# Rename this file to '.env' and populate it with actual environment values.
# =============================================================================

# Azure Target Subscription & Region
AZURE_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
AZURE_LOCATION="polandcentral"
ENVIRONMENT="dev"

# Azure Resource Group Naming (Format: rg-<project>-<env>-<location>-<sequence>)
AZURE_RESOURCE_GROUP_NAME="rg-bootstrap-dev-polandcentral-001"

# Azure Terraform State Backend Naming
# Storage account must be globally unique, 3-24 chars, lowercase alphanumeric only
AZURE_STORAGE_ACCOUNT_NAME="sttfstatedev001"
AZURE_CONTAINER_NAME="tfstate"

# Destructive Action Safeguard (Must be explicitly set to 'true' to allow destruction)
CONFIRM_DESTROY="false"

# Network Security & IP Whitelisting
# Comma-separated list of explicit allowed public IPs or CIDRs (e.g., "1.2.3.4,5.6.7.8/32")
ALLOWED_PUBLIC_IPS=""

# Automatically detect and whitelist the current machine's public IP during deployment
AUTO_DETECT_PUBLIC_IP="true"

# Mandatory Governance Resource Tags
TAG_PROJECT="Infra"
TAG_PURPOSE="TerraformState"
TAG_MANAGED_BY="AzureCLI"
TAG_COMPONENT="Bootstrap"
TAG_OWNER="Team"